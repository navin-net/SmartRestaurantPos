# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Option A: external / hosted PostgreSQL
# ---------------------------------------------------------------------------
# Full JDBC URL. When DB_URL is set it wins over DB_HOST/DB_PORT/DB_NAME.
# Add ?sslmode=require (or verify-full) for hosted providers such as Neon,
# Supabase, Railway, RDS, etc.
# DB_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
# Option B: split connection settings (also used by docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_DB=smartrestaurant
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me

# Spring Boot datasource credentials
DB_USERNAME=root
DB_PASSWORD=change-me

# Only needed when NOT using DB_URL (defaults: localhost:5433)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=smartrestaurant

# ---------------------------------------------------------------------------
# JWT Security
# ---------------------------------------------------------------------------
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
